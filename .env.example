# Example .env for human-out-of-the-loop (hootl).
# Copy to `.env` in the project root (or the directory you run hootl from).
# The real environment always wins over this file. Every variable is
# documented in docs/CONFIGURATION.md.

# ── Provider keys (set the one your model uses) ──────────────────
# OPENAI_API_KEY is only ever sent to api.openai.com, and
# ANTHROPIC_API_KEY only to api.anthropic.com — a custom endpoint
# uses HOTL_API_KEY (or the variable named by the model's apiKeyEnv).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── A custom OpenAI-compatible endpoint (optional) ───────────────
# HOTL_BASE_URL=http://localhost:11434/v1
# HOTL_MODEL=llama3
# HOTL_API_KEY=
# HOTL_API_STYLE=chat

# ── Run behaviour (optional) ─────────────────────────────────────
# HOTL_MODE=auto            # auto | chat | plan
# HOTL_THINKING=auto
# HOTL_TOOL_LOG=auto
# HOTL_RETENTION_DAYS=365   # 0 keeps plans/sessions forever

# ── run_command / run_tests (optional) ───────────────────────────
# Exact argv[0] names; `.ai-runtime/commands.json` is read only for a
# project trusted with --trust-project.
# HOTL_ALLOWED_COMMANDS=npm,node
# HOTL_TEST_COMMAND=npm test

# ── Web UI server (optional) ─────────────────────────────────────
# A non-loopback HOTL_HOST requires a token. Open the UI once as
# http://<host>:<port>/?token=<token>.
# HOTL_HOST=127.0.0.1
# HOTL_PORT=3000
# HOTL_SERVER_TOKEN=
# HOTL_RUN_TTL_MS=1800000
