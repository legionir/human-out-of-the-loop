{
  "schemaVersion": "1.0.0",
  "profile": {
    "id": "hootl.default",
    "name": "Default workflow",
    "description": "Baseline request, plan, execute, review, and bounded revision workflow.",
    "version": "1.0.0",
    "runtime": { "minVersion": "1.0.0" },
    "author": "HOOTL"
  },
  "dependencies": [
    { "kind": "persona", "id": "hootl.planner", "version": "1.0.0" },
    { "kind": "persona", "id": "hootl.executor", "version": "1.0.0" },
    { "kind": "persona", "id": "hootl.reviewer", "version": "1.0.0" },
    { "kind": "toolset", "id": "hootl.default-tools", "version": "1.0.0" },
    { "kind": "rubric", "id": "hootl.default-review", "version": "1.0.0" }
  ],
  "workflow": {
    "startNode": "request",
    "nodes": [
      {
        "id": "request", "kind": "intake", "goal": "Understand the request and identify missing information.",
        "inputs": { "request": { "type": "string", "required": true } },
        "outputs": {
          "request": { "type": "object", "required": true },
          "needsClarification": { "type": "boolean", "required": true },
          "question": { "type": "string" }
        },
        "config": { "classification": true }
      },
      {
        "id": "clarify", "kind": "approval", "goal": "Ask the user for missing information before planning.",
        "inputs": { "request": { "type": "object", "required": true }, "question": { "type": "string", "required": true } },
        "outputs": { "request": { "type": "object", "required": true }, "answer": { "type": "string", "required": true } },
        "config": { "prompt": "Please answer the clarification question to continue.", "approvalType": "custom" }
      },
      {
        "id": "plan", "kind": "planner", "goal": "Create a bounded, actionable plan.",
        "inputs": { "request": { "type": "object", "required": true }, "clarification": { "type": "string" } },
        "outputs": { "plan": { "type": "object", "required": true } },
        "bindings": { "personaRef": "hootl.planner", "skillRefs": [], "toolsetRef": "hootl.default-tools" },
        "config": { "mode": "decompose", "maxPlanItems": 20 },
        "onError": { "strategy": "ask-user", "maxAttempts": 1 }
      },
      {
        "id": "execute", "kind": "execute", "goal": "Carry out the plan within granted capabilities.",
        "inputs": { "plan": { "type": "object", "required": true }, "feedback": { "type": "string" } },
        "outputs": { "plan": { "type": "object", "required": true }, "result": { "type": "object", "required": true } },
        "bindings": { "personaRef": "hootl.executor", "skillRefs": [], "toolsetRef": "hootl.default-tools" },
        "config": { "mode": "assisted", "requireApprovalForSideEffects": true },
        "onError": { "strategy": "fail", "maxAttempts": 1 }
      },
      {
        "id": "review", "kind": "review", "goal": "Check whether the result satisfies the request and plan.",
        "inputs": { "plan": { "type": "object", "required": true }, "result": { "type": "object", "required": true } },
        "outputs": {
          "plan": { "type": "object", "required": true },
          "result": { "type": "object", "required": true },
          "decision": { "type": "string", "required": true },
          "feedback": { "type": "string" }
        },
        "bindings": { "personaRef": "hootl.reviewer", "skillRefs": [], "toolsetRef": "hootl.default-tools" },
        "config": { "rubricRef": "hootl.default-review", "allowedDecisions": ["pass", "revise", "reject"] }
      },
      {
        "id": "finish", "kind": "end", "goal": "Return the reviewed result.",
        "inputs": { "result": { "type": "object", "required": true } },
        "outputs": { "response": { "type": "object", "required": true } },
        "config": { "outcome": "success" }
      },
      {
        "id": "rejected", "kind": "end", "goal": "Return the result that did not pass review.",
        "inputs": { "result": { "type": "object", "required": true } },
        "outputs": { "response": { "type": "object", "required": true } },
        "config": { "outcome": "rejected" }
      }
    ],
    "edges": [
      { "from": "request", "to": "plan", "map": { "request": "/request" }, "when": { "outputPath": "/needsClarification", "operator": "equals", "value": false } },
      { "from": "request", "to": "clarify", "map": { "request": "/request", "question": "/question" }, "when": { "outputPath": "/needsClarification", "operator": "equals", "value": true } },
      { "from": "clarify", "to": "plan", "map": { "request": "/request", "clarification": "/answer" } },
      { "from": "plan", "to": "execute", "map": { "plan": "/plan" } },
      { "from": "execute", "to": "review", "map": { "plan": "/plan", "result": "/result" } },
      { "from": "review", "to": "finish", "map": { "result": "/result" }, "label": "pass", "when": { "outputPath": "/decision", "operator": "equals", "value": "pass" } },
      { "from": "review", "to": "execute", "map": { "plan": "/plan", "feedback": "/feedback" }, "label": "revise", "when": { "outputPath": "/decision", "operator": "equals", "value": "revise" }, "loop": { "maxIterations": 3, "counterId": "review-revision" } },
      { "from": "review", "to": "rejected", "map": { "result": "/result" }, "label": "reject", "when": { "outputPath": "/decision", "operator": "equals", "value": "reject" } }
    ]
  },
  "policies": {
    "execution": { "maxNodeVisits": 30, "maxDurationSeconds": 1800, "maxModelCalls": 40, "maxToolCalls": 100, "onLimit": "ask-user" },
    "tools": { "allowedToolsets": ["hootl.default-tools"], "deniedTools": [] },
    "approvals": { "policy": "side-effects", "requireUserConfirmationFor": ["external-write", "irreversible-action"] }
  },
  "result": [
    { "fromNode": "finish", "port": "response", "kind": "response", "outcome": "success" },
    { "fromNode": "rejected", "port": "response", "kind": "response", "outcome": "rejected" }
  ]
}
