{
  "$schema": "../workflow-profile.schema.json",
  "schemaVersion": "1.0.0",
  "profile": {
    "id": "example.error-route",
    "name": "Typed error route (failure is not an exception)",
    "description": "A work profile whose execute node declares a typed error route: when the delegated execution fails, the failure code is mapped into a rejected end instead of aborting the run. Everything else is the standard path \u2014 planner, digest-bound confirmation, delegated execution, success end \u2014 so the example shows exactly what an error route adds and what it cannot do (it cannot turn a failure into a success, cannot skip the confirmation, and cannot widen any capability). Dependency digests are real pins of the content this repository ships; re-pin them when that content changes.",
    "version": "1.0.0",
    "author": "HOOTL examples",
    "tags": [
      "example",
      "error-handling",
      "route"
    ]
  },
  "dependencies": [
    {
      "kind": "persona",
      "id": "planner",
      "version": "1.0.0",
      "digest": "sha256:432f1b39576a8221598d3f91e1a116dc6ce64998f2d6ac53cff9b391c45da4c4"
    }
  ],
  "workflow": {
    "startNode": "request",
    "nodes": [
      {
        "id": "request",
        "kind": "intake",
        "goal": "Carry the run request into the workflow.",
        "inputs": {
          "request": {
            "type": "object",
            "required": false
          }
        },
        "outputs": {
          "request": {
            "type": "object",
            "required": true
          }
        },
        "config": {}
      },
      {
        "id": "plan",
        "kind": "planner",
        "goal": "Plan the request (this profile only executes planned work).",
        "inputs": {
          "request": {
            "type": "object",
            "required": false
          },
          "context": {
            "type": "string",
            "required": false
          }
        },
        "outputs": {
          "kind": {
            "type": "string",
            "required": true,
            "enum": [
              "plan",
              "answer",
              "clarify"
            ]
          },
          "plan": {
            "type": "object",
            "required": false
          },
          "planText": {
            "type": "string",
            "required": false
          },
          "planDigest": {
            "type": "string",
            "required": false
          },
          "answer": {
            "type": "string",
            "required": false
          },
          "clarification": {
            "type": "string",
            "required": false
          }
        },
        "bindings": {
          "personaRef": "planner"
        },
        "config": {
          "mode": "decompose",
          "maxPlanItems": 20
        }
      },
      {
        "id": "confirm",
        "kind": "approval",
        "goal": "Show the plan and require a confirmation bound to its digest.",
        "inputs": {
          "plan": {
            "type": "object",
            "required": false
          },
          "planText": {
            "type": "string",
            "required": false
          },
          "planDigest": {
            "type": "string",
            "required": false
          }
        },
        "outputs": {
          "plan": {
            "type": "object",
            "required": true
          },
          "planText": {
            "type": "string",
            "required": true
          },
          "planDigest": {
            "type": "string",
            "required": true
          },
          "decision": {
            "type": "object",
            "required": true
          }
        },
        "config": {
          "prompt": "Review the plan. Execution starts only after this confirmation.",
          "approvalType": "side-effect",
          "responseKind": "decision",
          "bindsTo": "planText",
          "show": [
            "planText"
          ],
          "timeoutSeconds": 3600
        }
      },
      {
        "id": "execute",
        "kind": "execute",
        "goal": "Execute the confirmed plan with the step personas the plan names.",
        "inputs": {
          "plan": {
            "type": "object",
            "required": false
          },
          "planDigest": {
            "type": "string",
            "required": false
          }
        },
        "outputs": {
          "status": {
            "type": "string",
            "required": true
          },
          "summary": {
            "type": "string",
            "required": true
          }
        },
        "bindings": {
          "personaSource": "plan-step"
        },
        "config": {
          "mode": "assisted",
          "requireApprovalForSideEffects": true
        },
        "onError": {
          "strategy": "route",
          "routeTo": "failed",
          "routeMap": {
            "summary": "/failure/code"
          }
        }
      },
      {
        "id": "finish",
        "kind": "end",
        "goal": "Report the executed work.",
        "inputs": {
          "summary": {
            "type": "string",
            "required": true
          }
        },
        "outputs": {
          "response": {
            "type": "string",
            "required": true
          }
        },
        "config": {
          "outcome": "success",
          "emit": {
            "response": "summary"
          }
        }
      },
      {
        "id": "failed",
        "kind": "end",
        "goal": "Report a delegated execution failure as a rejected run.",
        "inputs": {
          "summary": {
            "type": "string",
            "required": true
          }
        },
        "outputs": {
          "response": {
            "type": "string",
            "required": true
          }
        },
        "config": {
          "outcome": "rejected",
          "emit": {
            "response": "summary"
          }
        }
      }
    ],
    "edges": [
      {
        "from": "request",
        "to": "plan",
        "map": {
          "request": "/request"
        }
      },
      {
        "from": "plan",
        "to": "confirm",
        "when": {
          "path": "/kind",
          "operator": "equals",
          "value": "plan"
        },
        "map": {
          "plan": "/plan",
          "planText": "/planText",
          "planDigest": "/planDigest"
        }
      },
      {
        "from": "plan",
        "to": "failed",
        "default": true,
        "map": {
          "summary": "/kind"
        }
      },
      {
        "from": "confirm",
        "to": "execute",
        "default": true,
        "map": {
          "plan": "/plan",
          "planDigest": "/planDigest"
        }
      },
      {
        "from": "execute",
        "to": "finish",
        "map": {
          "summary": "/summary"
        }
      }
    ]
  },
  "policies": {
    "execution": {
      "maxNodeVisits": 30,
      "maxDurationSeconds": 600,
      "maxModelCalls": 20,
      "maxToolCalls": 40,
      "onLimit": "fail"
    },
    "tools": {
      "allowedToolsets": [],
      "deniedTools": []
    },
    "approvals": {
      "policy": "runtime-default"
    }
  },
  "result": [
    {
      "fromNode": "finish",
      "port": "response",
      "kind": "response",
      "outcome": "success"
    },
    {
      "fromNode": "failed",
      "port": "response",
      "kind": "response",
      "outcome": "rejected"
    }
  ]
}
