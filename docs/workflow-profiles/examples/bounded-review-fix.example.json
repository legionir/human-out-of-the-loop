{
  "$schema": "../workflow-profile.schema.json",
  "schemaVersion": "1.0.0",
  "profile": {
    "id": "example.bounded-review-fix",
    "name": "Bounded review/fix loop",
    "description": "A complete work profile: plan, show the plan for a digest-bound confirmation, execute it inside the granted capabilities, review the result, and — when the review says `revise` — re-plan exactly once with the review's reason as context. The re-plan loop is bounded (`maxIterations: 1`); exhausting it fails the run instead of looping forever. A delegated execution failure is routed to the review (error policy), a rejection ends the run rejected, and cancellation/approval denial stay terminal. Dependency digests are real pins of the content this repository ships; re-pin them when that content changes.",
    "version": "1.0.0",
    "author": "HOOTL examples",
    "tags": ["example", "loop", "review", "approval"]
  },
  "dependencies": [
    {
      "kind": "persona",
      "id": "planner",
      "version": "1.0.0",
      "digest": "sha256:432f1b39576a8221598d3f91e1a116dc6ce64998f2d6ac53cff9b391c45da4c4"
    },
    {
      "kind": "persona",
      "id": "reviewer",
      "version": "1.0.0",
      "digest": "sha256:5f1259845dbea09cffcb715e0ce17559fc69fca08102b7d95a4edf63f537202d"
    },
    {
      "kind": "rubric",
      "id": "hootl.default-review",
      "version": "1.0.0",
      "digest": "sha256:f35a2e3948c85a8df55804a07c80e284a8c2a56003026a8bd266257ff421aae5"
    }
  ],
  "workflow": {
    "startNode": "request",
    "nodes": [
      {
        "id": "request",
        "kind": "intake",
        "goal": "Carry the run request into the workflow.",
        "inputs": { "request": { "type": "object", "required": false } },
        "outputs": { "request": { "type": "object", "required": true } },
        "config": {}
      },
      {
        "id": "plan",
        "kind": "planner",
        "goal": "Produce the plan to confirm, answer the request, or ask what is missing.",
        "inputs": {
          "request": { "type": "object", "required": false },
          "context": { "type": "string", "required": false }
        },
        "outputs": {
          "kind": { "type": "string", "required": true, "enum": ["plan", "answer", "clarify"] },
          "plan": { "type": "object", "required": false },
          "planText": { "type": "string", "required": false },
          "planDigest": { "type": "string", "required": false },
          "answer": { "type": "string", "required": false },
          "clarification": { "type": "string", "required": false }
        },
        "bindings": { "personaRef": "planner" },
        "config": { "mode": "decompose", "maxPlanItems": 20 }
      },
      {
        "id": "clarify",
        "kind": "approval",
        "goal": "Ask the user the questions the planner could not answer.",
        "inputs": { "clarification": { "type": "string", "required": false } },
        "outputs": { "answer": { "type": "string", "required": true } },
        "config": {
          "prompt": "The request needs clarification before a plan can be made. Please answer the questions.",
          "approvalType": "custom",
          "responseKind": "text",
          "show": ["clarification"],
          "timeoutSeconds": 3600
        }
      },
      {
        "id": "confirm",
        "kind": "approval",
        "goal": "Show the plan and obtain the mandatory confirmation before any side effect.",
        "inputs": {
          "plan": { "type": "object", "required": false },
          "planText": { "type": "string", "required": false },
          "planDigest": { "type": "string", "required": false }
        },
        "outputs": {
          "plan": { "type": "object", "required": true },
          "planText": { "type": "string", "required": true },
          "planDigest": { "type": "string", "required": true },
          "decision": { "type": "object", "required": true }
        },
        "config": {
          "prompt": "Review the plan. Execution starts only after this confirmation.",
          "approvalType": "side-effect",
          "responseKind": "decision",
          "bindsTo": "planText",
          "show": ["planText"],
          "timeoutSeconds": 3600
        }
      },
      {
        "id": "execute",
        "kind": "execute",
        "goal": "Carry out the confirmed plan within the granted capabilities.",
        "inputs": {
          "plan": { "type": "object", "required": true },
          "planDigest": { "type": "string", "required": false }
        },
        "outputs": {
          "status": { "type": "string", "required": true },
          "summary": { "type": "string", "required": true }
        },
        "bindings": { "personaSource": "plan-step" },
        "config": { "mode": "assisted", "requireApprovalForSideEffects": true },
        "onError": {
          "strategy": "route",
          "routeTo": "review",
          "routeMap": { "summary": "/failure/code", "status": "/failure/category" }
        }
      },
      {
        "id": "review",
        "kind": "review",
        "goal": "Judge whether the execution satisfied the plan and the request.",
        "inputs": {
          "summary": { "type": "string", "required": false },
          "status": { "type": "string", "required": false }
        },
        "outputs": {
          "decision": { "type": "string", "required": true, "enum": ["pass", "revise", "reject"] },
          "reason": { "type": "string", "required": true }
        },
        "bindings": { "personaRef": "reviewer" },
        "config": { "rubricRef": "hootl.default-review", "allowedDecisions": ["pass", "revise", "reject"] }
      },
      {
        "id": "answered",
        "kind": "end",
        "goal": "Return the direct answer to a conversational request.",
        "inputs": { "answer": { "type": "string", "required": false } },
        "outputs": { "response": { "type": "string", "required": false } },
        "config": { "outcome": "success", "emit": { "response": "answer" } }
      },
      {
        "id": "finish",
        "kind": "end",
        "goal": "Return the reviewed result.",
        "inputs": { "summary": { "type": "string", "required": true } },
        "outputs": { "response": { "type": "string", "required": true } },
        "config": { "outcome": "success", "emit": { "response": "summary" } }
      },
      {
        "id": "rejected",
        "kind": "end",
        "goal": "Return the result that did not pass review.",
        "inputs": { "summary": { "type": "string", "required": true } },
        "outputs": { "response": { "type": "string", "required": true } },
        "config": { "outcome": "rejected", "emit": { "response": "summary" } }
      }
    ],
    "edges": [
      { "from": "request", "to": "plan", "map": { "request": "/request" } },
      {
        "from": "plan",
        "to": "confirm",
        "when": { "path": "/kind", "operator": "equals", "value": "plan" },
        "map": { "plan": "/plan", "planText": "/planText", "planDigest": "/planDigest" }
      },
      {
        "from": "plan",
        "to": "answered",
        "when": { "path": "/kind", "operator": "equals", "value": "answer" },
        "map": { "answer": "/answer" }
      },
      {
        "from": "plan",
        "to": "clarify",
        "when": { "path": "/kind", "operator": "equals", "value": "clarify" },
        "map": { "clarification": "/clarification" },
        "label": "clarification-round",
        "loop": { "maxIterations": 3, "counterId": "clarification-rounds", "onExhausted": { "strategy": "fail" } }
      },
      { "from": "clarify", "to": "plan", "map": { "context": "/answer" } },
      { "from": "confirm", "to": "execute", "default": true, "map": { "plan": "/plan", "planDigest": "/planDigest" } },
      { "from": "execute", "to": "review", "map": { "summary": "/summary", "status": "/status" } },
      {
        "from": "review",
        "to": "finish",
        "when": { "path": "/decision", "operator": "equals", "value": "pass" },
        "map": { "summary": "/reason" }
      },
      {
        "from": "review",
        "to": "plan",
        "when": { "path": "/decision", "operator": "equals", "value": "revise" },
        "map": { "context": "/reason" },
        "label": "review-fix",
        "loop": { "maxIterations": 1, "counterId": "review-fix-rounds", "onExhausted": { "strategy": "fail" } }
      },
      {
        "from": "review",
        "to": "rejected",
        "when": { "path": "/decision", "operator": "equals", "value": "reject" },
        "map": { "summary": "/reason" }
      }
    ]
  },
  "policies": {
    "execution": {
      "maxNodeVisits": 80,
      "maxDurationSeconds": 3600,
      "maxModelCalls": 100,
      "maxToolCalls": 200,
      "onLimit": "fail"
    },
    "tools": { "allowedToolsets": [], "deniedTools": [] },
    "approvals": {
      "policy": "side-effects",
      "requireUserConfirmationFor": ["external-write", "file-write", "git-write", "irreversible-action"]
    }
  },
  "result": [
    { "fromNode": "answered", "port": "response", "kind": "response", "outcome": "success" },
    { "fromNode": "finish", "port": "response", "kind": "response", "outcome": "success" },
    { "fromNode": "rejected", "port": "response", "kind": "response", "outcome": "rejected" }
  ]
}
